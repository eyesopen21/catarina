{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/plataforma-docente/curriculum-rule.schema.json",
  "title": "CurriculumRule",
  "description": "Regla curricular versionada (S05 §Sistema de reglas, FR-CUR-02, ADR-016). Publicada = inmutable (INV-12).",
  "type": "object",
  "required": ["id", "curriculum_version_id", "source_id", "source_version", "source_section", "effective_from", "education_level", "modality", "subject", "rule_type", "rule_class", "severity", "validator", "human_explanation", "exceptions", "validation_status"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "curriculum_version_id": { "type": "string", "format": "uuid" },
    "source_id": { "type": "string", "format": "uuid" },
    "source_version": { "type": "string" },
    "source_section": { "type": "string", "description": "Apartado o página del documento fuente" },
    "effective_from": { "type": "string", "format": "date" },
    "effective_to": { "type": ["string", "null"], "format": "date" },
    "education_level": { "type": "string", "enum": ["I_ciclo", "II_ciclo"] },
    "modality": { "type": "string" },
    "subject": { "type": "string", "enum": ["espanol", "matematica", "estudios_sociales_civica", "ciencias"] },
    "rule_type": { "type": "string", "enum": ["structure", "sequence", "indicator", "annex", "competency", "periodicity", "adaptation", "presentation"] },
    "rule_class": { "type": "string", "enum": ["required_by_MEP", "recommended_by_pedagogy", "teacher_preference", "local_institution_policy"] },
    "severity": { "type": "string", "enum": ["error", "warning", "info"] },
    "validator": {
      "type": "object",
      "required": ["validator_id", "params"],
      "properties": {
        "validator_id": { "type": "string" },
        "params": { "type": "object" }
      },
      "additionalProperties": false
    },
    "human_explanation": { "type": "string", "minLength": 1 },
    "exceptions": { "type": "array", "items": { "type": "string" } },
    "validation_status": { "type": "string", "enum": ["unvalidated", "expert_validated"] },
    "validated_at": { "type": ["string", "null"], "format": "date" },
    "revalidate_by": { "type": ["string", "null"], "format": "date" }
  },
  "additionalProperties": false
}
