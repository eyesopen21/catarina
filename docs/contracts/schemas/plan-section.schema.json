{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/plataforma-docente/plan-section.schema.json",
  "title": "PlanSection",
  "description": "Sección editable y aprobable de un plan (bloque en la suite v0.4). INV-01, INV-02, FR-PLN-01.",
  "type": "object",
  "required": ["id", "plan_id", "kind", "position", "state", "current_version_id", "row_version", "content", "links"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "plan_id": { "type": "string", "format": "uuid" },
    "kind": {
      "type": "string",
      "enum": ["learning_outcome", "content", "methodology", "strategy", "activity", "question", "annex", "indicator", "instrument", "time", "source", "competency", "reflection"]
    },
    "position": { "type": "integer", "minimum": 0 },
    "title": { "type": "string", "maxLength": 200 },
    "state": { "type": "string", "enum": ["draft", "proposed", "approved", "reopened"] },
    "current_version_id": { "type": "string", "format": "uuid" },
    "approved_version_id": { "type": ["string", "null"], "format": "uuid" },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "row_version": { "type": "integer", "minimum": 0 },
    "content": { "$ref": "#/$defs/SectionContent" },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["to_section_id", "link_type"],
        "properties": {
          "to_section_id": { "type": "string", "format": "uuid" },
          "link_type": { "type": "string", "enum": ["supports", "evidences", "references_annex", "assesses", "depends_on"] }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "approved" } } },
      "then": { "required": ["approved_version_id"], "properties": { "approved_version_id": { "type": "string" } } }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "SectionContent": {
      "description": "Contenido por tipo. El anexo separa la hoja del estudiante del solucionario docente (FR-PLN-07).",
      "oneOf": [
        { "$ref": "#/$defs/TextContent" },
        { "$ref": "#/$defs/ActivityContent" },
        { "$ref": "#/$defs/AnnexContent" },
        { "$ref": "#/$defs/IndicatorContent" }
      ]
    },
    "TextContent": {
      "type": "object",
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string", "maxLength": 20000 }
      },
      "additionalProperties": false
    },
    "ActivityContent": {
      "type": "object",
      "required": ["type", "moment", "teacher_actions", "student_actions", "instructions", "grouping", "materials", "estimated_minutes", "learning_outcome_ids"],
      "properties": {
        "type": { "const": "activity" },
        "moment": { "type": "string", "description": "Fase metodológica de la plantilla aplicable (p. ej. inicio, desarrollo, cierre; focalización, exploración, contrastación, aplicación)" },
        "teacher_actions": { "type": "string", "minLength": 1 },
        "student_actions": { "type": "string", "minLength": 1 },
        "instructions": { "type": "string", "minLength": 1, "description": "Consigna textual completa" },
        "grouping": { "type": "string" },
        "materials": { "type": "array", "items": { "type": "string" } },
        "questions": { "type": "array", "items": { "type": "string" } },
        "scaffolds": { "type": "array", "items": { "type": "string" } },
        "estimated_minutes": { "type": "integer", "minimum": 1 },
        "evidence": { "type": "string" },
        "learning_outcome_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uuid" } },
        "competency_codes": { "type": "array", "items": { "type": "string" } },
        "annex_ids": { "type": "array", "items": { "type": "string", "format": "uuid" } },
        "indicator_ids": { "type": "array", "items": { "type": "string", "format": "uuid" } }
      },
      "additionalProperties": false
    },
    "AnnexContent": {
      "type": "object",
      "required": ["type", "student_title", "student_instructions", "items"],
      "properties": {
        "type": { "const": "annex" },
        "student_title": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "^\\s*[Aa]nexo\\s*\\d+" },
          "description": "Título natural visible al estudiante (BR-05); no puede ser «Anexo N»"
        },
        "student_instructions": { "type": "string", "minLength": 1 },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["prompt"],
            "properties": {
              "prompt": { "type": "string", "minLength": 1 },
              "example": { "type": "string" },
              "answer_space": { "type": "string", "enum": ["none", "line", "box", "table"] }
            },
            "additionalProperties": false
          }
        },
        "teacher_solution": { "type": "string", "description": "Solucionario; nunca se incluye en la hoja del estudiante" },
        "is_simulated_example": { "type": "boolean", "default": false, "description": "Datos de ejemplo simulados (BR-08)" }
      },
      "additionalProperties": false
    },
    "IndicatorContent": {
      "type": "object",
      "required": ["type", "observable_action", "learning_outcome_id", "observed_in_activity_id"],
      "properties": {
        "type": { "const": "indicator" },
        "observable_action": { "type": "string", "minLength": 1 },
        "content": { "type": "string" },
        "condition": { "type": "string" },
        "learning_outcome_id": { "type": "string", "format": "uuid" },
        "observed_in_activity_id": { "type": "string", "format": "uuid" }
      },
      "additionalProperties": false
    }
  }
}
