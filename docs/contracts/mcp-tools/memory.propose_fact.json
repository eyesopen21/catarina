{
  "name": "memory.propose_fact",
  "description": "Propone un hecho de memoria como candidate con condición inferencia_por_confirmar. Nunca confirma (INV-04). La propuesta queda visible al docente para aceptar, editar o rechazar.",
  "requiredScopes": ["memory:propose"],
  "sideEffects": "creates_pending_proposal",
  "dataClassMax": "C2",
  "requiresApproval": false,
  "rateLimit": { "perMinute": 20 },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["scope", "scope_ref", "predicate_key", "statement", "evidence", "task_id", "step_key"],
    "properties": {
      "scope": { "type": "string", "enum": ["teacher", "group", "plan"] },
      "scope_ref": { "type": "string", "format": "uuid" },
      "predicate_key": { "type": "string", "maxLength": 120 },
      "statement": { "type": "string", "minLength": 1, "maxLength": 500 },
      "evidence": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["evidence_type", "evidence_ref"],
          "properties": {
            "evidence_type": { "type": "string", "enum": ["decision_event", "reflection", "conversation_turn"] },
            "evidence_ref": { "type": "string", "format": "uuid" }
          },
          "additionalProperties": false
        }
      },
      "task_id": { "type": "string", "format": "uuid" },
      "step_key": { "type": "string", "minLength": 1, "maxLength": 120 }
    },
    "additionalProperties": false
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["result"],
    "properties": {
      "result": { "type": "string", "enum": ["created", "already_exists", "rejected_dlp", "rejected_out_of_scope"] },
      "fact_id": { "type": ["string", "null"], "format": "uuid" },
      "status": { "type": "string", "const": "candidate" }
    },
    "additionalProperties": false
  }
}
