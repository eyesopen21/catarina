{
  "name": "memory.search_facts",
  "description": "Recupera hechos de memoria confirmados y vigentes del docente o de un grupo autorizado, con procedencia y razón. Aplica tenant, grupo, audiencia, vigencia y propósito antes de devolver. Nunca devuelve identidad de estudiantes ni hechos de otros grupos.",
  "requiredScopes": ["memory:read"],
  "sideEffects": "none",
  "dataClassMax": "C2",
  "requiresApproval": false,
  "rateLimit": { "perMinute": 60 },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["scope", "scope_ref", "purpose"],
    "properties": {
      "scope": { "type": "string", "enum": ["teacher", "group", "plan"] },
      "scope_ref": { "type": "string", "format": "uuid" },
      "purpose": { "type": "string", "enum": ["draft_section", "selective_revision", "annex", "indicators"] },
      "query": { "type": "string", "maxLength": 300 },
      "as_of": { "type": "string", "format": "date-time" },
      "limit": { "type": "integer", "minimum": 1, "maximum": 20, "default": 10 }
    },
    "additionalProperties": false
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["items"],
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["fact_id", "statement", "condition", "valid_from", "provenance", "reason"],
          "properties": {
            "fact_id": { "type": "string", "format": "uuid" },
            "statement": { "type": "string" },
            "condition": { "type": "string", "enum": ["observado", "preferencia_confirmada"] },
            "valid_from": { "type": "string", "format": "date-time" },
            "valid_to": { "type": ["string", "null"], "format": "date-time" },
            "provenance": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["evidence_type", "evidence_ref"],
                "properties": {
                  "evidence_type": { "type": "string" },
                  "evidence_ref": { "type": "string", "format": "uuid" }
                },
                "additionalProperties": false
              }
            },
            "reason": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  }
}
